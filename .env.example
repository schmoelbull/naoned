# ---------- Application ----------
PORT=3000
HOST=127.0.0.1
# Mot de passe de connexion au tableau de bord
ADMIN_PASSWORD=change-moi
# Chaîne aléatoire longue (openssl rand -hex 32)
SESSION_SECRET=
# true si le dashboard est servi en HTTPS (recommandé derrière Nginx + certbot)
COOKIE_SECURE=true
DATA_DIR=./data

# ---------- OpenAI ----------
OPENAI_API_KEY=sk-...
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_SUMMARY_MODEL=gpt-4o-mini
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe

# ---------- Asterisk ARI ----------
ARI_URL=http://127.0.0.1:8088
ARI_USER=naoned
ARI_PASSWORD=
ARI_APP=naoned
# Plage de ports UDP locaux (127.0.0.1) pour le flux audio Asterisk <-> Node
RTP_PORT_MIN=30000
RTP_PORT_MAX=30999
MAX_CONCURRENT_CALLS=5
# Dossier des enregistrements Asterisk
RECORDING_DIR=/var/spool/asterisk/recording

# ---------- Trunk SIP (utilisé par deploy/install.sh pour générer pjsip.conf) ----------
SIP_PROVIDER_HOST=sip.example.net
SIP_USERNAME=0033xxxxxxxxx
SIP_PASSWORD=
# IP publique du VPS
PUBLIC_IP=
# Mot de passe du softphone de test (extension 6001)
TEST_PHONE_PASSWORD=
